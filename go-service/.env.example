# ─────────────────────────────────────────────
# Go service
# ─────────────────────────────────────────────
GO_ADDR=:8081
GO_REQUEST_TIMEOUT=5s
GO_LOG_LEVEL=info
GO_NODE_API_BASE_URL=http://localhost:5007

# ─────────────────────────────────────────────
# Postgres (dev only)
# ─────────────────────────────────────────────
PG_DB=school_mgmt
PG_USER=postgres
PG_PASSWORD=postgres

# ─────────────────────────────────────────────
# Node backend (dev only)
# ─────────────────────────────────────────────
NODE_PORT=5007
NODE_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/school_mgmt

NODE_JWT_ACCESS_TOKEN_SECRET=dev_access_secret
NODE_JWT_REFRESH_TOKEN_SECRET=dev_refresh_secret
NODE_CSRF_TOKEN_SECRET=dev_csrf_secret
NODE_EMAIL_VERIFICATION_TOKEN_SECRET=dev_email_verification_secret
NODE_PASSWORD_SETUP_TOKEN_SECRET=dev_password_setup_secret

NODE_JWT_ACCESS_TOKEN_TIME_IN_MS=900000
NODE_JWT_REFRESH_TOKEN_TIME_IN_MS=28800000
NODE_CSRF_TOKEN_TIME_IN_MS=950000
NODE_EMAIL_VERIFICATION_TOKEN_TIME_IN_MS=18000000
NODE_PASSWORD_SETUP_TOKEN_TIME_IN_MS=300000

NODE_API_URL=http://localhost:5007
NODE_UI_URL=http://localhost:5173
NODE_COOKIE_DOMAIN=localhost

# Dev-only flag for Problem 7 integration testing
NODE_DISABLE_AUTH=true
